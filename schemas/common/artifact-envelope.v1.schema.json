{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DameurMounir/transformation-portfolio-contracts/v1.0.0/schemas/common/artifact-envelope.v1.schema.json",
  "title": "ArtifactEnvelope.v1",
  "description": "The common immutable envelope for all transformation portfolio artifacts. Supersession uses an immutable replacement model: a new normally active artifact may carry supersession.semantics=IMMUTABLE_REPLACEMENT and supersession.supersedes to identify an older same-stage artifact; the older artifact is never mutated and consumers must reject it once the replacement is present.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "spec_version",
    "digest_profile",
    "artifact_type",
    "artifact_id",
    "transformation_id",
    "case_id",
    "stage",
    "status",
    "produced_at",
    "producer",
    "inputs",
    "authority",
    "payload_sha256",
    "artifact_sha256",
    "chain_sha256",
    "payload",
    "limitations"
  ],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "spec_version": {"$ref": "#/$defs/semver"},
    "digest_profile": {"const": "TPC-JCS-SHA256-v1"},
    "artifact_type": {
      "type": "string",
      "enum": [
        "RequirementsAssessment",
        "StakeholderAlignmentPacket",
        "ProcessRedesignDecision",
        "ChangeImpactPacket",
        "GoLiveEvidenceBundle",
        "GoLiveDecisionPacket"
      ]
    },
    "artifact_id": {"$ref": "#/$defs/stableId"},
    "transformation_id": {"$ref": "#/$defs/stableId"},
    "case_id": {"$ref": "#/$defs/stableId"},
    "stage": {
      "type": "string",
      "enum": [
        "REQUIREMENTS_QUALITY",
        "STAKEHOLDER_ALIGNMENT",
        "PROCESS_REDESIGN",
        "CHANGE_IMPACT",
        "GO_LIVE_EVIDENCE",
        "GO_LIVE_DECISION"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "VALIDATED",
        "HUMAN_CONFIRMED",
        "CONDITIONALLY_APPROVED",
        "APPROVED",
        "BLOCKED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "produced_at": {"$ref": "#/$defs/utcTimestamp"},
    "producer": {"$ref": "#/$defs/producer"},
    "inputs": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/artifactReference"}
    },
    "authority": {
      "oneOf": [
        {"$ref": "human-decision.v1.schema.json"},
        {"type": "null"}
      ]
    },
    "payload_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "chain_sha256": {"$ref": "#/$defs/sha256"},
    "payload": {"type": "object"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "supersession": {
      "description": "Optional only on the new replacement artifact; it never changes the recorded status or bytes of the older artifact.",
      "$ref": "#/$defs/supersession"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["HUMAN_CONFIRMED", "CONDITIONALLY_APPROVED", "APPROVED", "REJECTED", "SUPERSEDED"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["authority"],
        "properties": {"authority": {"$ref": "human-decision.v1.schema.json"}}
      }
    }
  ],
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "releaseTag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "release", "commit_sha", "tree_sha", "tool_version"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"},
        "source_uri": {"type": "string", "format": "uri", "maxLength": 2048},
        "release": {"$ref": "#/$defs/releaseTag"},
        "commit_sha": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
        "tree_sha": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
        "tool_version": {"$ref": "#/$defs/semver"}
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_id",
        "transformation_id",
        "schema_version",
        "sha256",
        "chain_sha256",
        "relationship",
        "status",
        "produced_at"
      ],
      "properties": {
        "artifact_type": {"$ref": "#/$defs/artifactType"},
        "artifact_id": {"$ref": "#/$defs/stableId"},
        "transformation_id": {"$ref": "#/$defs/stableId"},
        "schema_version": {"$ref": "#/$defs/semver"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "chain_sha256": {"$ref": "#/$defs/sha256"},
        "relationship": {
          "type": "string",
          "enum": ["DERIVED_FROM", "CONSTRAINED_BY", "ASSEMBLES", "EVIDENCED_BY", "SUPERSEDES"]
        },
        "status": {
          "type": "string",
          "enum": ["VALIDATED", "HUMAN_CONFIRMED", "CONDITIONALLY_APPROVED", "APPROVED", "BLOCKED", "REJECTED", "SUPERSEDED"]
        },
        "produced_at": {"$ref": "#/$defs/utcTimestamp"},
        "source_uri": {"type": "string", "format": "uri", "maxLength": 2048}
      }
    },
    "artifactType": {
      "type": "string",
      "enum": [
        "RequirementsAssessment",
        "StakeholderAlignmentPacket",
        "ProcessRedesignDecision",
        "ChangeImpactPacket",
        "GoLiveEvidenceBundle",
        "GoLiveDecisionPacket"
      ]
    },
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "description": "A forward-only claim made by the replacement artifact. The referenced predecessor retains its original active status and digest; lifecycle validation derives its effective superseded state from this record.",
      "required": ["semantics", "supersedes", "reason", "recorded_at", "authority_decision_id"],
      "properties": {
        "semantics": {"const": "IMMUTABLE_REPLACEMENT"},
        "supersedes": {
          "allOf": [
            {"$ref": "#/$defs/artifactReference"},
            {"properties": {"relationship": {"const": "SUPERSEDES"}}}
          ]
        },
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "recorded_at": {"$ref": "#/$defs/utcTimestamp"},
        "authority_decision_id": {"$ref": "#/$defs/stableId"}
      }
    }
  }
}
