{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DameurMounir/transformation-portfolio-contracts/v1.0.0/schemas/common/finding.v1.schema.json",
  "title": "Finding.v1",
  "description": "A portable analysis finding with evidence, ownership and closure actions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "finding_type",
    "severity",
    "status",
    "summary",
    "reason_codes",
    "evidence_refs",
    "owner",
    "required_actions"
  ],
  "properties": {
    "finding_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$"},
    "finding_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"},
    "severity": {"type": "string", "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "status": {"type": "string", "enum": ["OPEN", "ACKNOWLEDGED", "REMEDIATED", "WAIVED", "CLOSED"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"}
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "evidence-reference.v1.schema.json"}
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "role"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "role": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}
      }
    },
    "required_actions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id", "description", "status"],
        "properties": {
          "action_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$"},
          "description": {"type": "string", "minLength": 1, "maxLength": 2000},
          "status": {"type": "string", "enum": ["OPEN", "IN_PROGRESS", "COMPLETED", "WAIVED"]},
          "due_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "severity": {"enum": ["HIGH", "CRITICAL"]},
          "status": {"enum": ["OPEN", "ACKNOWLEDGED"]}
        },
        "required": ["severity", "status"]
      },
      "then": {"properties": {"required_actions": {"minItems": 1}}}
    }
  ]
}
