{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DameurMounir/transformation-agent-contracts/v1.1.0/schemas/envelope/v1.1.json",
  "title": "RuntimeEnvelope.v1.1",
  "description": "Signed, digest-bound, framework-neutral runtime envelope for governed workflow messages.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "spec_version",
    "digest_profile",
    "envelope_id",
    "actor",
    "tenant",
    "correlation",
    "schema_uri",
    "artifact_references",
    "evidence_references",
    "policy_context",
    "policy_context_digest",
    "payload",
    "payload_digest",
    "issued_at",
    "expires_at",
    "idempotency_key",
    "signature"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/DameurMounir/transformation-agent-contracts/v1.1.0/schemas/envelope/v1.1.json"
    },
    "spec_version": {
      "const": "1.1.0"
    },
    "digest_profile": {
      "const": "TPC-JCS-SHA256-v1"
    },
    "envelope_id": {
      "$ref": "#/$defs/stableId"
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "tenant": {
      "$ref": "#/$defs/tenant"
    },
    "correlation": {
      "$ref": "#/$defs/correlation"
    },
    "schema_uri": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "artifact_references": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/artifactReference"
      }
    },
    "evidence_references": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/evidenceReference"
      }
    },
    "policy_context": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "policy_context_digest": {
      "$ref": "#/$defs/sha256"
    },
    "payload": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_$][A-Za-z0-9_$ .:/-]{0,127}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "payload_digest": {
      "$ref": "#/$defs/sha256"
    },
    "issued_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "actor_type",
        "accountable_principal_id"
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/stableId"
        },
        "actor_type": {
          "enum": [
            "HUMAN",
            "SERVICE",
            "AGENT"
          ]
        },
        "accountable_principal_id": {
          "$ref": "#/$defs/stableId"
        },
        "agent_id": {
          "$ref": "#/$defs/stableId"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "actor_type": {
                "const": "AGENT"
              }
            },
            "required": [
              "actor_type"
            ]
          },
          "then": {
            "required": [
              "agent_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "actor_type": {
                "enum": [
                  "HUMAN",
                  "SERVICE"
                ]
              }
            },
            "required": [
              "actor_type"
            ]
          },
          "then": {
            "not": {
              "required": [
                "agent_id"
              ]
            }
          }
        }
      ]
    },
    "tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "workspace_id",
        "environment"
      ],
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/stableId"
        },
        "workspace_id": {
          "$ref": "#/$defs/stableId"
        },
        "environment": {
          "enum": [
            "DEVELOPMENT",
            "TEST",
            "STAGING",
            "PRODUCTION"
          ]
        }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correlation_id",
        "traceparent"
      ],
      "properties": {
        "correlation_id": {
          "$ref": "#/$defs/stableId"
        },
        "causation_id": {
          "$ref": "#/$defs/stableId"
        },
        "traceparent": {
          "type": "string",
          "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "schema_uri",
        "digest",
        "relationship"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/stableId"
        },
        "schema_uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "relationship": {
          "enum": [
            "INPUT",
            "OUTPUT",
            "SUPERSEDES",
            "EVIDENCES"
          ]
        }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "kind",
        "digest"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/stableId"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "algorithm",
        "key_id",
        "signed_digest",
        "value",
        "signed_at"
      ],
      "properties": {
        "profile": {
          "const": "TPC-HMAC-SHA256-v1"
        },
        "algorithm": {
          "const": "HMAC-SHA256"
        },
        "key_id": {
          "$ref": "#/$defs/stableId"
        },
        "signed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "value": {
          "$ref": "#/$defs/sha256"
        },
        "signed_at": {
          "$ref": "#/$defs/utcTimestamp"
        }
      }
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "maxProperties": 256,
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    }
  }
}
