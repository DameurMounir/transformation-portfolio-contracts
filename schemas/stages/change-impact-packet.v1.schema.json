{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DameurMounir/transformation-portfolio-contracts/v1.0.0/schemas/stages/change-impact-packet.v1.schema.json",
  "title": "ChangeImpactPacket.v1",
  "description": "A lineage-bound assessment of direct, indirect, conditional and explicitly unaffected change. A replacement remains VALIDATED and may carry an IMMUTABLE_REPLACEMENT supersession pointer to the unchanged older packet.",
  "allOf": [
    {"$ref": "../common/artifact-envelope.v1.schema.json"},
    {
      "type": "object",
      "properties": {
        "$schema": {"const": "https://raw.githubusercontent.com/DameurMounir/transformation-portfolio-contracts/v1.0.0/schemas/stages/change-impact-packet.v1.schema.json"},
        "artifact_type": {"const": "ChangeImpactPacket"},
        "stage": {"const": "CHANGE_IMPACT"},
        "status": {"const": "VALIDATED"},
        "inputs": {
          "minItems": 1,
          "maxItems": 1,
          "contains": {
            "required": ["artifact_type", "relationship"],
            "properties": {
              "artifact_type": {"const": "ProcessRedesignDecision"},
              "relationship": {"const": "DERIVED_FROM"}
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        "authority": {"type": "null"},
        "payload": {"$ref": "#/$defs/payload"}
      }
    }
  ],
  "$defs": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_package_id",
        "selected_process_option_id",
        "derived_from_artifact_id",
        "derived_from_artifact_sha256",
        "business_graph_sha256",
        "rulebook_sha256",
        "case_digest",
        "analysis_digest",
        "portfolio_chain_sha256",
        "direct_impacts",
        "indirect_impacts",
        "conditional_impacts",
        "explicitly_unaffected",
        "obligations",
        "collisions",
        "risks"
      ],
      "properties": {
        "change_package_id": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/stableId"},
        "selected_process_option_id": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/stableId"},
        "derived_from_artifact_id": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/stableId"},
        "derived_from_artifact_sha256": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/sha256"},
        "business_graph_sha256": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/sha256"},
        "rulebook_sha256": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/sha256"},
        "case_digest": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/sha256"},
        "analysis_digest": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/sha256"},
        "portfolio_chain_sha256": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/sha256"},
        "direct_impacts": {"$ref": "#/$defs/directImpacts"},
        "indirect_impacts": {"$ref": "#/$defs/indirectImpacts"},
        "conditional_impacts": {"$ref": "#/$defs/conditionalImpacts"},
        "explicitly_unaffected": {"$ref": "#/$defs/unaffectedImpacts"},
        "obligations": {
          "type": "array",
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/obligation"}
        },
        "collisions": {
          "type": "array",
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/collision"}
        },
        "risks": {
          "type": "array",
          "maxItems": 10000,
          "items": {"$ref": "../common/risk-envelope.v1.schema.json"}
        }
      }
    },
    "impactBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["impact_id", "impact_kind", "category", "target_id", "summary", "severity", "evidence_refs", "dependency_ids", "condition", "rationale"],
      "properties": {
        "impact_id": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/stableId"},
        "impact_kind": {"type": "string", "enum": ["DIRECT", "INDIRECT", "CONDITIONAL", "UNAFFECTED"]},
        "category": {"type": "string", "enum": ["PEOPLE", "PROCESS", "TECHNOLOGY", "DATA", "CONTROL", "VENDOR", "LOCATION", "POLICY"]},
        "target_id": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/stableId"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
        "severity": {"type": "string", "enum": ["NONE", "LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "../common/evidence-reference.v1.schema.json"}
        },
        "dependency_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/stableId"}
        },
        "condition": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 2000},
            {"type": "null"}
          ]
        },
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "directImpacts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/impactBase"},
          {"properties": {"impact_kind": {"const": "DIRECT"}, "condition": {"type": "null"}}}
        ]
      }
    },
    "indirectImpacts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/impactBase"},
          {"properties": {"impact_kind": {"const": "INDIRECT"}, "condition": {"type": "null"}}}
        ]
      }
    },
    "conditionalImpacts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/impactBase"},
          {"properties": {"impact_kind": {"const": "CONDITIONAL"}, "condition": {"type": "string", "minLength": 1}}}
        ]
      }
    },
    "unaffectedImpacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/impactBase"},
          {"properties": {"impact_kind": {"const": "UNAFFECTED"}, "severity": {"const": "NONE"}, "condition": {"type": "null"}}}
        ]
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "impact_ids", "obligation_type", "description", "owner", "status", "due_at", "evidence_refs"],
      "properties": {
        "obligation_id": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/stableId"},
        "impact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/stableId"}
        },
        "obligation_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"},
        "description": {"type": "string", "minLength": 1, "maxLength": 4000},
        "owner": {"type": "string", "minLength": 1, "maxLength": 128},
        "status": {"type": "string", "enum": ["OPEN", "IN_PROGRESS", "SATISFIED", "WAIVED"]},
        "due_at": {
          "oneOf": [
            {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/utcTimestamp"},
            {"type": "null"}
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {"$ref": "../common/evidence-reference.v1.schema.json"}
        }
      }
    },
    "collision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collision_id", "left_id", "right_id", "collision_type", "severity", "resolution_status", "resolution"],
      "properties": {
        "collision_id": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/stableId"},
        "left_id": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/stableId"},
        "right_id": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/stableId"},
        "collision_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"},
        "severity": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "resolution_status": {"type": "string", "enum": ["OPEN", "RESOLVED", "ACCEPTED"]},
        "resolution": {"type": ["string", "null"], "maxLength": 4000}
      }
    }
  }
}
