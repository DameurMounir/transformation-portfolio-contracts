{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DameurMounir/transformation-portfolio-contracts/v1.0.0/schemas/stages/process-redesign-decision.v1.schema.json",
  "title": "ProcessRedesignDecision.v1",
  "description": "The digest-bound human selection or rejection of a controlled TO-BE process option. A replacement remains a normal active decision and may carry an IMMUTABLE_REPLACEMENT supersession pointer to the unchanged older decision.",
  "allOf": [
    {"$ref": "../common/artifact-envelope.v1.schema.json"},
    {
      "type": "object",
      "properties": {
        "$schema": {"const": "https://raw.githubusercontent.com/DameurMounir/transformation-portfolio-contracts/v1.0.0/schemas/stages/process-redesign-decision.v1.schema.json"},
        "artifact_type": {"const": "ProcessRedesignDecision"},
        "stage": {"const": "PROCESS_REDESIGN"},
        "status": {"enum": ["HUMAN_CONFIRMED", "REJECTED"]},
        "inputs": {
          "minItems": 2,
          "maxItems": 2,
          "allOf": [
            {
              "contains": {
                "required": ["artifact_type", "relationship"],
                "properties": {
                  "artifact_type": {"const": "RequirementsAssessment"},
                  "relationship": {"const": "DERIVED_FROM"}
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "required": ["artifact_type", "relationship"],
                "properties": {
                  "artifact_type": {"const": "StakeholderAlignmentPacket"},
                  "relationship": {"const": "CONSTRAINED_BY"}
                }
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "authority": {"$ref": "../common/human-decision.v1.schema.json"},
        "payload": {"$ref": "#/$defs/payload"}
      }
    },
    {
      "if": {"properties": {"status": {"const": "REJECTED"}}, "required": ["status"]},
      "then": {
        "properties": {
          "authority": {"properties": {"action": {"const": "REJECT"}, "outcome": {"const": "REJECTED"}}},
          "payload": {"properties": {"selection": {"properties": {"action": {"const": "REJECT"}, "outcome": {"const": "REJECTED"}}}}}
        }
      }
    }
  ],
  "$defs": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_decision_id",
        "selected_option_id",
        "constraining_condition_ids",
        "comparison_digest",
        "options_assessed",
        "to_be_process",
        "controls_preserved",
        "assumptions",
        "target_metrics",
        "selection"
      ],
      "properties": {
        "process_decision_id": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/stableId"},
        "selected_option_id": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/stableId"},
        "constraining_condition_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/stableId"}
        },
        "comparison_digest": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/sha256"},
        "options_assessed": {
          "type": "array",
          "minItems": 2,
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/optionAssessment"}
        },
        "to_be_process": {"$ref": "#/$defs/processModel"},
        "controls_preserved": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/stableId"}
        },
        "assumptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "target_metrics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/targetMetric"}
        },
        "selection": {"$ref": "../common/human-decision.v1.schema.json"}
      }
    },
    "optionAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "title", "control_ids", "effort_person_days", "cost_minor_units", "currency", "duration_days", "change_risk"],
      "properties": {
        "option_id": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/stableId"},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "control_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/stableId"}
        },
        "effort_person_days": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "cost_minor_units": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "duration_days": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "change_risk": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]}
      }
    },
    "processModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process_id", "version", "steps"],
      "properties": {
        "process_id": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/stableId"},
        "version": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/semver"},
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step_id", "name", "owner_role", "predecessor_step_ids", "controls"],
            "properties": {
              "step_id": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/stableId"},
              "name": {"type": "string", "minLength": 1, "maxLength": 500},
              "owner_role": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
              "predecessor_step_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/stableId"}
              },
              "controls": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/stableId"}
              }
            }
          }
        }
      }
    },
    "targetMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "name", "unit", "target_value", "measurement_window_days"],
      "properties": {
        "metric_id": {"$ref": "../common/artifact-envelope.v1.schema.json#/$defs/stableId"},
        "name": {"type": "string", "minLength": 1, "maxLength": 500},
        "unit": {"type": "string", "minLength": 1, "maxLength": 64},
        "target_value": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
        "measurement_window_days": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    }
  }
}
